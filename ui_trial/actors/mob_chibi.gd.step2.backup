extends Node2D
## 5-part lightweight enemy preview. VISUAL ONLY.
var _elapsed: float = 0.0
var _busy: bool = false
var head_node: Node2D
var body_node: Node2D
var left_arm: Node2D
var right_arm: Node2D
var _rest_pos: Vector2

func _ready() -> void:
    _rest_pos = position
    var legs := Node2D.new()
    legs.position = Vector2(0, -38)
    add_child(legs)
    _part(legs, "mob_legs", Vector2.ZERO)
    left_arm = Node2D.new()
    left_arm.position = Vector2(-49, -132)
    add_child(left_arm)
    _part(left_arm, "mob_arm", Vector2(-1, 41))
    body_node = Node2D.new()
    body_node.position = Vector2(0, -121)
    add_child(body_node)
    _part(body_node, "mob_body", Vector2.ZERO)
    right_arm = Node2D.new()
    right_arm.position = Vector2(49, -132)
    add_child(right_arm)
    _part(right_arm, "mob_arm", Vector2(0, 42))
    head_node = Node2D.new()
    head_node.position = Vector2(0, -211)
    add_child(head_node)
    _part(head_node, "mob_head", Vector2.ZERO)

func _part(parent: Node2D, part_name: String, offset: Vector2) -> void:
    var sprite := Sprite2D.new()
    sprite.texture = load("res://ui_trial/assets/%s.png" % part_name)
    sprite.scale = Vector2(0.5, 0.5)
    sprite.position = offset
    parent.add_child(sprite)

func _process(delta: float) -> void:
    _elapsed += delta
    if _busy:
        return
    body_node.position.y = -121 + sin(_elapsed * 2.4) * 1.8
    head_node.rotation_degrees = sin(_elapsed * 1.5) * 3.0
    left_arm.rotation_degrees = -8 + sin(_elapsed * 2.0) * 5.0
    right_arm.rotation_degrees = 8 - sin(_elapsed * 2.0) * 5.0

func play_hit(speed: float = 1.0) -> void:
    if _busy:
        return
    _busy = true
    var factor: float = 1.0 / maxf(0.2, speed)
    var knocked := create_tween()
    knocked.set_parallel(true)
    knocked.tween_property(self, "position", _rest_pos + Vector2(26, -7), 0.09 * factor)
    knocked.tween_property(self, "modulate", Color(1.0, 0.42, 0.42), 0.09 * factor)
    knocked.tween_property(head_node, "rotation_degrees", 17.0, 0.09 * factor)
    await knocked.finished
    var recover := create_tween()
    recover.set_parallel(true)
    recover.tween_property(self, "position", _rest_pos, 0.22 * factor)
    recover.tween_property(self, "modulate", Color.WHITE, 0.22 * factor)
    recover.tween_property(head_node, "rotation_degrees", 0.0, 0.22 * factor)
    await recover.finished
    _busy = false
